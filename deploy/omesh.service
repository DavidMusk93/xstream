[Unit]
Description=omesh Compute & HTTP Range CDN Edge Daemon
After=network-online.target ostore.service xstream-bt.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/xstream
EnvironmentFile=-/etc/ostore.env
EnvironmentFile=-/etc/omesh.env
Environment=RUST_LOG=omesh=info
ExecStart=/root/xstream/rust/target/release/omesh
Restart=on-failure
RestartSec=3s
User=root
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
