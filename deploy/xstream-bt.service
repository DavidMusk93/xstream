[Unit]
Description=xstream BitTorrent Streaming Daemon (Rust librqbit + axum)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/xstream
Environment=RUST_LOG=xstream_bt=info,librqbit=warn
Environment=XSTREAM_BT_BIND=127.0.0.1:8766
Environment=XSTREAM_BT_CACHE_DIR=/root/xstream/cache/rqbit
Environment=XSTREAM_BT_LISTEN_PORT=6882
ExecStart=/root/xstream/rust/target/release/xstream_bt
Restart=on-failure
RestartSec=3s
User=root
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
